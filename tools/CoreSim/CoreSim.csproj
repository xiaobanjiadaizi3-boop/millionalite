<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unity を使わずに Assets/Scripts/Core のロジックだけを検証するためのプロジェクト。
       Unity プロジェクト本体からは参照されない（Assets の外に置いてある）。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>CoreSim</AssemblyName>
    <RootNamespace>Millionalite.CoreSim</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Scripts/Core/*.cs" />
  </ItemGroup>

</Project>
